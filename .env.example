# Copie para .env e preencha. O .env nunca é versionado.
# Nenhum valor real entra neste arquivo — só os nomes das variáveis.

# API de agendamento (AgendaFácil) — ver ADR 0003.
# Em desenvolvimento, aponta para a instância local: http://localhost:3000/api
AGENDA_API_BASE_URL=
# Slug do estabelecimento no AgendaFácil.
AGENDA_TENANT=
# A escrita exige um token do Cloudflare Turnstile, que é um desafio de
# navegador. Com a secret de teste da Cloudflare no AgendaFácil local, qualquer
# valor aqui é aceito. Não existe valor que funcione contra produção.
AGENDA_TOKEN_DESAFIO=
# Registro de intenções da ADR 0005. Precisa sobreviver ao processo morrer.
AGENDA_REGISTRO_INTENCOES=local/intencoes.jsonl

# LLM
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# STT — deixe vazio para usar o modo local na fase de desenvolvimento
STT_PROVIDER=
STT_API_KEY=

# TTS — idem
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=

# Limites da demo pública (plano.md §8)
DEMO_MAX_SESSION_SECONDS=
DEMO_MAX_SESSIONS_PER_DAY=
